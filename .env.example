# ── Server ──────────────────────────────────────────
PORT=3000

# ── GHL OAuth ────────────────────────────────────────
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=https://yourdomain.com/oauth/callback

# Optional: hard-code a GHL access token to bypass the OAuth refresh flow
# GHL_ACCESS_TOKEN=

# ── GHL Webhook Security ─────────────────────────────
# Set this to the secret configured in your GHL workflow webhook action.
# If blank, signature verification is skipped (not recommended in production).
GHL_WEBHOOK_SECRET=

# ── Podium OAuth ──────────────────────────────────────
PODIUM_CLIENT_ID=
PODIUM_CLIENT_SECRET=
PODIUM_REDIRECT_URI=https://app.captevrix.com/oauth/podium/callback

# ── Podium Webhook ────────────────────────────────────
# Full public URL of your /webhook/podium endpoint.
# Used by GET /setup/register-webhook to register with Podium's API.
PODIUM_WEBHOOK_URL=https://app.captevrix.com/webhook/podium

# HMAC secret for verifying Podium webhook events.
# Either set this before calling /setup/register-webhook (Podium will use it
# to sign events), or copy it from the response after registration.
PODIUM_WEBHOOK_SECRET=

# ── Podium Account Config ─────────────────────────────
# locationUid is required for POST /v4/messages.
# Find it in Podium Settings → Locations or via GET /v4/locations.
PODIUM_LOCATION_UID=

# Optional: label shown under sent messages in the Podium inbox (e.g. "GHL Bot")
PODIUM_SENDER_NAME=

# ── Test Endpoint Protection ──────────────────────────
# Requests to GET /test-contact must include ?secret=<value> when this is set.
TEST_SECRET=
